# Copy to ".env" and fill in real values. NEVER commit .env.

# MongoDB — the Master Hub is INDEPENDENT of the other portals. Use any database you like
# (a separate one is perfectly fine). Collections are prefixed "mh_".

MONGO_URI=mongodb://tescosalescrm_db_user:tescosales123@ac-wh3dhoz-shard-00-00.18tr6ii.mongodb.net:27017,ac-wh3dhoz-shard-00-01.18tr6ii.mongodb.net:27017,ac-wh3dhoz-shard-00-02.18tr6ii.mongodb.net:27017/salescrm?ssl=true&replicaSet=atlas-kbbwg6-shard-0&authSource=admin&appName=Cluster0
COLLECTION_PREFIX=mh_

# JWT signing key — at least 32 random chars. Generate with: npm run gen:secret
JWT_SECRET=<paste-output-of-npm-run-gen:secret>
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Only the authorised Managing Directors (no public registration).
MAX_MDS=3

PORT=5200
NODE_ENV=development
CORS_ORIGIN=*

# Used to build the password-reset link. Set to the Master Hub web address in production.
APP_URL=http://localhost:5175
RESET_TOKEN_TTL_MIN=60

# Optional: SMTP for password-reset emails. If left blank, the reset link is printed to the
# server console (fine for a 3-user internal tool).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tesco Master Hub <no-reply@tesco>
